# Exclude sensitive environment variables and secrets
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Exclude git tracking
.git
.gitignore
.github

# Exclude Node dependencies and local build outputs
**/node_modules
**/build
**/dist
**/out
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Exclude IDE/system files
.vscode
.idea
.DS_Store
Thumbs.db
